# generated by FreeCam/make_zip.py - the copy inside the zip is the shipped one
FreeCam/packaging/SHA256SUMS.txt

# generated by FreeCam/make_dropin.py - the zip is the shipped copy of these
FreeCam/dropin/

# zig leaves these behind
FreeCam/src/*.res.o
FreeCam/menu/*.res.o
FreeCam/menu/build/

# python leaves these behind when the server's modules are imported by a test
__pycache__/

# the player's own profile and the server's log - never shipped, never committed
LocalServer/state.json
LocalServer/logs/

# the game itself - never committed, only used by the RE tools
TriadWars.exe
TriadWars.exe.orig

# twre.py's disassembly cache, rebuilt on demand
LocalServer/tools/re_cache.pkl
