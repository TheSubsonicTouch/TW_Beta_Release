// freecam_standalone.rc - version information and a manifest for FreeCam.dll.
//
// Nothing here changes what the DLL does. It exists because a Windows binary with no
// version information at all - no name, no publisher, no description - is one of the
// things heuristics score badly, and this one is an unsigned DLL that hooks a game.
// Saying plainly what it is (a free camera for Triad Wars) is the honest thing to ship
// and it is what a normal application's resources look like.
//
// Numbers instead of <winver.h> constants, so the resource compiler needs no headers:
//   FILEOS 0x40004 = VOS_NT_WINDOWS32    FILETYPE 0x2 = VFT_DLL
//   FILEFLAGSMASK 0x3f, FILEFLAGS 0      FILESUBTYPE 0

1 VERSIONINFO
 FILEVERSION 1,0,0,15
 PRODUCTVERSION 1,0,0,15
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TheSubsonicTouch"
            VALUE "FileDescription",  "Triad Wars Free Camera - standalone DLL"
            VALUE "FileVersion",      "1.0.0.15"
            VALUE "InternalName",     "FreeCam"
            VALUE "LegalCopyright",   "Free camera by TheSubsonicTouch. Triad Wars is (c) United Front Games / Square Enix."
            VALUE "OriginalFilename", "FreeCam.dll"
            VALUE "ProductName",      "Triad Wars Free Camera"
            VALUE "ProductVersion",   "1.0.0.15"
            VALUE "Comments",         "Game camera control for the offline Triad Wars build. No network, no install, no keylogger: it reads the keyboard only for its own hotkeys and never sends anything anywhere."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The side-by-side assembly identity. Purely descriptive: no dependencies, no
// requestedExecutionLevel (a DLL has none), nothing that changes loading.
1 24 "freecam_standalone.manifest"
